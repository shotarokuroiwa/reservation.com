<h1>施設検索</h1>

<%= form_with url: searches_path, method: :get, class: 'search-form' do |form| %>
  <div class="form-group">
    <%= form.label :area %>
    <%= form.text_field :area, placeholder: 'エリアを入力' %>
  </div>

  <div class="form-group">
    <%= form.label :keyword %>
    <%= form.text_field :keyword, placeholder: 'キーワードを入力' %>
  </div>

  <div class="form-group">
    <%= form.submit '検索', class: 'btn btn-primary' %>
  </div>
<% end %>

<% if @rooms %>
  <h2>検索結果</h2>
  <div class="grid-container">
    <% @rooms.each do |room| %>
      <div class="card">
        <% if room.image.attached? %>
          <%= image_tag room.image, class: 'card-image' %>
        <% end %>
        <div class="card-content">
          <h3><%= room.name %></h3>
          <p>価格: <%= room.price %></p>
          <%= link_to '予約する', new_room_reservation_path(room), class: 'btn btn-secondary' %>
        </div>
      </div>
    <% end %>
  </div>
<% end %>
