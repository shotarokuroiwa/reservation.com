<h1><%= @room.name %></h1>

<% if @room.image.attached? %>
  <%= image_tag @room.image %>
<% end %>

<p>説明: <%= @room.description %></p>
<p>住所: <%= @room.address %></p>
<p>価格: <%= @room.price %></p>

<% if current_user == @room.user %>
  <%= link_to '編集', edit_room_path(@room) %>
  <%= link_to '削除', room_path(@room), method: :delete, data: { confirm: '本当に削除しますか?' } %>
<% end %>

<%= link_to 'この施設を予約する', new_room_reservation_path(@room) %>
